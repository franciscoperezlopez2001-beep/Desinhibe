# ─── URL pública del sitio (canonical, sitemap, Open Graph) ───────────────
NEXT_PUBLIC_SITE_URL=https://www.casafrancisco.es

# ─── Emails (Resend · https://resend.com) ─────────────────────────────────
# Sin RESEND_API_KEY los emails no se envían (en desarrollo se muestran en consola).
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. "Casa Francisco <reservas@casafrancisco.es>"
EMAIL_FROM=
# Buzón del restaurante que recibe las reservas y solicitudes
RESTAURANT_EMAIL=

# ─── Base de datos (Supabase · https://supabase.com) ──────────────────────
# Ejecuta supabase/schema.sql en el SQL Editor de tu proyecto.
# La service role key solo se usa en el servidor: NUNCA la expongas con NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Anti-spam (Cloudflare Turnstile · opcional pero recomendado) ─────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Panel /admin ─────────────────────────────────────────────────────────
# Contraseña del panel y secreto para firmar la sesión (mín. 32 caracteres aleatorios).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ─── Reservas externas (opcional) ─────────────────────────────────────────
# Si usáis CoverManager, TheFork u otro, pega aquí la URL de reserva y la web
# mostrará ese enlace en lugar del formulario propio.
NEXT_PUBLIC_EXTERNAL_BOOKING_URL=

# ─── Analítica (opcional; solo se carga si el usuario acepta cookies) ─────
NEXT_PUBLIC_GA_ID=
